{
  "name": "torrenthub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "torrenthub": "bin/torrenthub.js"
  },
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && mkdir -p dist/server/bin && cp bin/*.js dist/server/bin/",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "server:dev": "nodemon",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\"",
    "start": "node dist/server/bin/torrenthub.js",
    "start:dev": "tsx bin/torrenthub.js",
    "package:windows": "npm run build && npm run build:server && node scripts/build-windows.js",
    "package:windows-arm64": "npm run build && npm run build:server && node scripts/build-windows.js --arch arm64",
    "package:macos": "npm run build && npm run build:server && node scripts/build-macos.js",
    "package:linux": "npm run build && npm run build:server && node scripts/build-windows.js --platform linux",
    "package:all": "npm run build && npm run build:server && node scripts/build-macos.js && node scripts/build-windows.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "multer": "^1.4.5-lts.1",
    "open": "^10.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}